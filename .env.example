# =============================================================================
# Variables de entorno para la Aplicación Web y Despliegue (EA3)
# Copiar este archivo como '.env' para ejecución local personalizada.
# En GitHub Actions y entornos cloud, estas variables se inyectan en el entorno.
# =============================================================================

# Entorno de ejecución: development | staging | production
APP_ENV=production

# Versión semántica del servicio desplegado
APP_VERSION=3.0.0

# Dirección de escucha y puerto del servidor web WSGI (app.py)
HOST=0.0.0.0
PORT=8000

# Ruta del archivo CSV con el catálogo extraído de Mercado Libre
DATA_PATH=iphone_17_pro_max_mercadolibre.csv

# Carpeta de salida para el artefacto estático desplegado en GitHub Pages
OUTPUT_DIR=docs

# Plataforma de alojamiento en la nube destino
DEPLOY_TARGET=GitHub Pages

# Metadatos de trazabilidad inyectados automáticamente por GitHub Actions
BUILD_COMMIT_SHA=local-build
BUILD_RUN_NUMBER=1

# Modo de depuración (true/false)
DEBUG_MODE=false
